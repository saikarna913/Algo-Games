{
  "expo": {
    "name": "CS Board Games",
    "slug": "cs-board-games",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E1E5EA"
    },
    "android": {
