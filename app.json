        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E1E5EA"
      },
      "package": "com.yourname.csboardgames",
      "versionCode": 1,
      "permissions": []
    },
    "plugins": ["expo-font"],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
